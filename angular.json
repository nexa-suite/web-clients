{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "cache": {
      "enabled": true,
      "path": ".angular/cache",
      "environment": "all"
    }
  },
  "newProjectRoot": "apps",
  "projects": {
    "platform": {
      "projectType": "application",
      "root": "apps/platform",
      "sourceRoot": "apps/platform/src",
      "prefix": "platform",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/apps/platform",
            "browser": "apps/platform/src/main.ts",
            "tsConfig": "apps/platform/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "*.svg",
                "input": "logo-nexa",
                "output": "brand/canonical"
              }
            ],
            "styles": [
              "src/styles.scss",
              "apps/platform/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "56kB",
                  "maximumError": "58kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "platform:build:production"
            },
            "development": {
              "buildTarget": "platform:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/platform/tsconfig.spec.json"
          }
        }
      }
    },
    "portal": {
      "projectType": "application",
      "root": "apps/portal",
      "sourceRoot": "apps/portal/src",
      "prefix": "portal",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/apps/portal",
            "browser": "apps/portal/src/main.ts",
            "tsConfig": "apps/portal/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "*.svg",
                "input": "logo-nexa",
                "output": "brand/canonical"
              }
            ],
            "styles": [
              "src/styles.scss",
              "apps/portal/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "56kB",
                  "maximumError": "58kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portal:build:production"
            },
            "development": {
              "buildTarget": "portal:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/portal/tsconfig.spec.json"
          }
        }
      }
    },
    "nexa-ui": {
      "projectType": "library",
      "root": "libs/nexa-ui",
      "sourceRoot": "libs/nexa-ui/src",
      "prefix": "nexa",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/nexa-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/nexa-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/nexa-ui/tsconfig.spec.json"
          }
        }
      }
    },
    "nexa-api": {
      "projectType": "library",
      "root": "libs/nexa-api",
      "sourceRoot": "libs/nexa-api/src",
      "prefix": "nexa-api",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/nexa-api/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/nexa-api/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/nexa-api/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
